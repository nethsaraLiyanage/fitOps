# Template for the docker-compose stack. Copy to `.env` and fill in real
# values — `.env` is gitignored, this file is not, so keep secrets out of here.
#
#   cp .env.docker.example .env
#   # then generate real secrets:
#   #   openssl rand -hex 32   -> JWT_SECRET
#   #   openssl rand -hex 16   -> MONGO_PASSWORD

# Mongo runs with auth enabled and is never published to the host.
MONGO_USER=fitops
MONGO_PASSWORD=change-me

# Must be at least 16 characters or the API refuses to boot (see config/env.ts).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# WEB_BIND=127.0.0.1 keeps the stack on this machine only.
# WEB_BIND=0.0.0.0 exposes it to the network / internet.
WEB_BIND=0.0.0.0
WEB_PORT=5173

# Must match the origin users actually browse to, e.g. https://fitops.example.com
CORS_ORIGIN=http://localhost:5173

# The gym's own timezone. Attendance "today" and every date-bucketed report derive
# from the API container's timezone — leave this unset and it runs on UTC, which
# shifts those views by a day for anyone not already in UTC.
TZ=Asia/Colombo

# Login attempts allowed per IP per 15 minutes before the API returns 429.
LOGIN_RATE_LIMIT=10

# Seeded logins. The defaults (admin123 / staff123) are printed on the login
# screen and committed to a public repo — always override them for any
# deployment reachable beyond localhost.
SEED_ADMIN_EMAIL=admin@fitops.lk
SEED_ADMIN_PASSWORD=change-me
SEED_STAFF_EMAIL=staff@fitops.lk
SEED_STAFF_PASSWORD=change-me
