MONGODB_URI=mongodb://localhost:27017/fitops
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
PORT=4000
CORS_ORIGIN=http://localhost:8080
NODE_ENV=development

# Login attempts allowed per IP per 15 minutes.
LOGIN_RATE_LIMIT=10

# The gym's own timezone. Attendance "today" and every date-bucketed report derive
# from the process timezone, so a container without this set silently buckets by UTC.
TZ=Asia/Colombo
